# Optional settings. Nothing here is required to run toon locally; the defaults just work.
# Copy to `.env` and uncomment what you need. The checks (`npm run check`, `npm run check:site`) and the docs
# server/build (`npm run docs:dev`, `docs:build`) read this file. Variables already set in your shell win.

# Browser for the checks. By default they use an installed Chrome, Chromium or Edge, then Playwright's download.
# CHROME_PATH=/usr/bin/google-chrome
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Force Playwright's pinned Chromium (what CI uses) for results identical to CI.
# Needs: npx playwright install chromium
# CHECK_BROWSER=bundled

# Where Playwright stores its browsers (default: ~/.cache/ms-playwright on Linux).
# PLAYWRIGHT_BROWSERS_PATH=

# Docs site URL and sub-path. Only needed when hosting under a sub-path; the GitHub Pages workflow sets both.
# Defaults: SITE_URL=http://localhost:4321  BASE_PATH=/
# SITE_URL=https://you.github.io
# BASE_PATH=/toon/
