---
/**
 * The global site footer (Figma: Explorations → Option 3 → Footer). A full-width navy band; its contents sit in
 * the same centered container as the header (max-width 90rem, margin-inline auto, padding-inline 2.5rem).
 * Rendered after the page by components/PageFrame.astro. Colors and fonts come from styles/saturday.css.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer print:hidden">
  <div class="site-footer-inner">
    <a class="site-footer-logo" href={base} translate="no">toon</a>
    <p class="site-footer-note">
      <a href="https://github.com/kelseythejackson/toon/blob/main/LICENSE">MIT licensed</a>. Made by Kelsey Jackson.
    </p>
  </div>
</footer>

<style>
  .site-footer-inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 2rem;
    max-width: 90rem; margin-inline: auto; padding: 1.75rem 2.5rem 2.5rem;
  }
  .site-footer-logo { text-decoration: none; line-height: 1; }
  .site-footer-note { margin: 0; }
  .site-footer-note a { color: inherit; text-decoration: none; }
  .site-footer-note a:hover { text-decoration: underline; text-underline-offset: .2em; }
</style>
