---
/**
 * Overrides Starlight's ThemeSelect: adds a sketchbook-style picker beside the light/dark switch.
 * The choice is applied and saved by src/scripts/motion.js (inlined in <head>, so there's no flash).
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import Select from '@astrojs/starlight/components/Select.astro';

const styles = [
  { value: 'graph', label: 'Graph Notebook' },
  { value: 'riso', label: 'Riso Press' },
  { value: 'collage', label: 'Cut & Paste' },
  { value: 'crayon', label: 'Crayon Cloud' },
];
---
<div class="toon-pickers">
  {/* Hidden for now: the site uses the Saturday morning look only (styles/saturday.css). Remove `hidden` to bring it back,
      and drop the pin in scripts/motion.js. */}
  <toon-style-select hidden>
    <Select icon="pencil" label="Sketchbook style"
      options={styles.map((s, i) => ({ ...s, selected: i === 0 }))} width="11.25em" />
  </toon-style-select>
  <Default />
</div>

{/* Sync the picker with the saved style before paint. */}
<script is:inline>
  document.querySelectorAll('toon-style-select select').forEach((s) => (s.value = document.documentElement.dataset.style));
</script>

<style>
  .toon-pickers { display: flex; gap: var(--space-md); align-items: center; }
  /* Both selects are sized in em, so text enlarged on its own (browser text-size settings) doubles them and pushes
   * them off the screen. Cap each at a share of the window; a long style name truncates instead. */
  .toon-pickers :global(select) { text-overflow: ellipsis; }
  .toon-pickers toon-style-select :global(select) { max-width: max(14vw, 180px); }   /* fits "Graph Notebook" at normal size */
  .toon-pickers :global(starlight-theme-select select) { max-width: max(9vw, 110px); }
</style>
