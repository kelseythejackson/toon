---
/**
 * Overrides Starlight's Header: the one global nav from the Saturday morning design (Figma: Explorations →
 * Option 3 → Nav). The navy bar runs the full width of the window; its contents sit in a centered container
 * (margin-inline: auto, padding-inline: 2.5rem). Logo, the main sections, a "Get started" pill, then search
 * and the light/dark switch, kept as small controls at the end.
 * Colors and fonts come from styles/saturday.css.
 */
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  { label: 'Principles', href: 'principles/' },
  { label: 'Find an effect', href: 'find-an-effect/' },
  { label: 'Recipes', href: 'recipes/' },
  { label: 'API', href: 'api/css/', match: 'api/' },
];
const path = Astro.url.pathname.replace(base, '');
const isCurrent = (l: { href: string; match?: string }) => path.startsWith(l.match ?? l.href);
---

<div class="toon-nav">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <nav class="nav-links print:hidden" aria-label="Site sections">
    {links.map((l) => (
      <a href={base + l.href} aria-current={isCurrent(l) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a class="nav-cta" href={base + 'install/'} aria-current={path.startsWith('install/') ? 'page' : undefined}>Get started</a>
  </nav>
  <div class="nav-tools sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex"><ThemeSelect /></div>
  </div>
</div>

<style>
  .toon-nav {
    display: flex; align-items: center; gap: 1.5rem;
    height: 100%; max-width: 90rem; margin-inline: auto; padding-inline: 2.5rem;
  }
  .title-wrapper { overflow: clip; padding: .25rem; margin: -.25rem; min-width: 0; margin-inline-end: auto; }
  .nav-links { display: none; align-items: center; gap: clamp(1rem, 2.2vw, 2.25rem); }
  .nav-links a { font-weight: 700; font-size: 1.125rem; text-decoration: none; white-space: nowrap; }
  .nav-tools { align-items: center; gap: .75rem; }
  /* The main links need the room of a laptop screen; below that the sidebar menu carries the same pages. */
  @media (min-width: 72rem) { .nav-links { display: flex; } }
</style>
