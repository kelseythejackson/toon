---
/**
 * Shows a recipe's code and, under it, the same code running.
 * The code is read at build time from examples/<dir>/<file> (dir defaults to recipes), from the regions between markers:
 *   HTML  <!-- @recipe --> … <!-- @end -->      JS  // @recipe … // @end      CSS  /* @recipe *\/ … /* @end *\/
 * so the snippet on the page and the live example can never drift apart. Inside a region, `// @fold` … `// @end-fold`
 * mark setup lines that start folded (the markers are not shown or copied). `npm run check` pastes each block this
 * component shows into a bare page, exactly as shown, and runs it (scripts/recipe-regions.mjs builds the blocks for both).
 *   show  which regions to print (0-based indexes, default all)
 *   join  print the shown regions as ONE html block (styles, markup, then <script>), so one copy is a working page.
 *         Any snippet that needs a script must be joined.
 *   demo  embed the running page under the code (default true)
 *   dir   folder under examples/ (default 'recipes'; '' for examples/ itself, e.g. a principle demo)
 *   before  lines to print above the first shown block, in the same block (e.g. the <link> that loads toon.css)
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Code } from '@astrojs/starlight/components';
import Demo from './Demo.astro';
import { recipeBlocks } from '../../../scripts/recipe-regions.mjs';

interface Props { file: string; show?: number[]; join?: boolean; demo?: boolean; title?: string; dir?: string; before?: string }
const { file, show, join = false, demo = true, title, dir = 'recipes', before } = Astro.props;

const source = readFileSync(resolve(process.cwd(), '../examples', dir, file), 'utf8');
const blocks: { lang: string; code: string; collapse: string[] }[] = recipeBlocks(source, { show, join, before });
if (!blocks.length) throw new Error(`Recipe ${file} has no @recipe regions`);
const pageTitle = title ?? source.match(/<h1>([^<]*)<\/h1>/)?.[1] ?? 'Live example';
// A title passed in reads as a name ("the Canvas anticipation demo"); a page's own <h1> is quoted.
const linkText = title ? `Open the ${title} on its own page` : `Open “${pageTitle}” on its own page`;
---
{blocks.map((b) => <Code code={b.code} lang={b.lang} wrap collapse={b.collapse.length ? b.collapse : undefined} />)}
{demo && (
  <div class="recipe-result">
    <p class="recipe-label">Result</p>
    <Demo file={dir ? `${dir}/${file}` : file} title={pageTitle} source={false} linkText={linkText} />
  </div>
)}

<style>
  .recipe-result { margin-top: var(--space-md); }
  .recipe-label { margin: 0 0 calc(var(--space-sm) * -1); font-size: var(--sl-text-xs); font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--sl-color-gray-3); }
</style>
